{
  "name": "devforge",
  "private": true,
  "version": "0.4.0",
  "description": "Developer Project Launcher",
  "license": "GPL-3.0-only",
  "author": "victhille",
  "repository": {
    "type": "git",
    "url": "https://github.com/victhille/devforge"
  },
  "homepage": "https://victhille.github.io/devforge/",
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/third-party-licenses.mjs --notices",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "dist": "npm run build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,tsx,js,mjs,cjs}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,tsx,js,mjs,cjs}\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "release": "node scripts/release.mjs",
    "licenses": "node scripts/third-party-licenses.mjs",
    "prepare": "lefthook install"
  },
  "build": {
    "appId": "com.devforge.app",
    "productName": "DevForge",
    "copyright": "Copyright © 2026 victhille",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/licenses/**",
      "!out/*.tsbuildinfo",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/x64/{DirectML.dll,dxcompiler.dll,dxil.dll}",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!node_modules/node-pty/prebuilds/darwin-*/**",
      "!node_modules/node-pty/prebuilds/win32-arm64/**",
      "!**/node_modules/**/*.{map,d.ts,d.mts,d.cts,md,markdown}",
      "!**/node_modules/@anthropic-ai/sdk/src/**",
      "!**/node_modules/sql.js/dist/!(sql-wasm.js|sql-wasm.wasm)",
      "!**/node_modules/@huggingface/transformers/dist/!(transformers.node.cjs|transformers.node.mjs)",
      "!**/node_modules/@huggingface/transformers/src/**",
      "!**/node_modules/@img/sharp-wasm32/**",
      "!**/node_modules/node-pty/third_party/conpty/*/win10-arm64/**"
    ],
    "extraResources": [
      {
        "from": "src/renderer/src/assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "out/licenses/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/src/assets/icon.png",
      "artifactName": "${productName}-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevForge",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "victhille",
        "repo": "devforge",
        "private": false
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "electronLanguages": [
      "fr",
      "en-US"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "electron-updater": "6.8.11",
    "mysql2": "3.24.6",
    "node-pty": "1.1.0",
    "pg": "8.23.1",
    "sql.js": "1.17.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20.11.0",
    "@types/pg": "8.23.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/sql.js": "1.16.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axe-core": "4.14.1",
    "clsx": "^2.1.1",
    "electron": "44.11.5",
    "electron-builder": "26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "highlight.js": "11.12.0",
    "lefthook": "2.2.2",
    "lucide-react": "^1.76.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.73.0",
    "uqr": "0.1.3",
    "vite": "^6.4.6",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch@^9": "^11.0.1",
    "minimatch@^10": "^11.0.1"
  }
}
