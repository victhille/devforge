---
/**
 * Page not found, in the look of the home page. GitHub Pages serves this one
 * file for every missing address: it is written in French and switches to
 * English when the address is under /en/.
 */
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const issue = 'https://github.com/victhille/devforge/issues/new?title=Lien%20cass%C3%A9%20sur%20le%20site'
const t = {
  fr: {
    title: 'Page introuvable · DevForge', kicker: 'Erreur 404', h1: "Cette page n'existe pas, ou plus.",
    text: "Le lien est peut-être ancien, ou l'adresse a une faute de frappe. Forgy fait une sieste en attendant ; voilà par où repartir.",
    home: "Retour à l'accueil", docs: 'Ouvrir la documentation', download: 'Télécharger', start: 'Prise en main', forgy: 'Forgy', report: 'Signaler un lien cassé',
    sleeping: 'Forgy fait une sieste', other: 'EN', privacy: "Ni cookie ni mesure d'audience.", made: 'DevForge · open source, sur GitHub'
  },
  en: {
    title: 'Page not found · DevForge', kicker: 'Error 404', h1: 'This page does not exist, or no longer.',
    text: 'The link may be old, or the address has a typo. Forgy is taking a nap meanwhile; here is where to go next.',
    home: 'Back to home', docs: 'Open the docs', download: 'Download', start: 'Getting started', forgy: 'Forgy', report: 'Report a broken link',
    sleeping: 'Forgy is taking a nap', other: 'FR', privacy: 'No cookies, no analytics.', made: 'DevForge · open source, on GitHub'
  }
}
// The French texts go in the page; the script swaps in the English ones under /en/
const en = JSON.stringify(t.en)
const f = t.fr
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{f.title}</title>
  <meta name="theme-color" content="#F6F4EF" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href={`${base}/`} data-home-link>
        <span class="brand-mark"><svg width="18" height="18" viewBox="0 0 256 256" aria-hidden="true"><g fill="#f97316"><polygon points="40.96,87.04 199.68,87.04 199.68,117.76 76.8,117.76"></polygon><rect x="107.52" y="117.76" width="61.44" height="30.72"></rect><rect x="81.92" y="148.48" width="112.64" height="25.6"></rect></g></svg></span>
        DevForge
      </a>
      <div class="top-end">
        <a class="lang" href={`${base}/en/`} data-other data-t="other">{f.other}</a>
        <a class="btn btn-dark btn-sm" href={`${base}/download/`} data-path="download/" data-t="download">{f.download}</a>
      </div>
    </div>
  </header>

  <main class="wrap main">
    <div class="text">
      <p class="kicker" data-t="kicker">{f.kicker}</p>
      <h1 data-t="h1">{f.h1}</h1>
      <p class="lead" data-t="text">{f.text}</p>
      <div class="actions">
        <a class="btn btn-dark btn-lg" href={`${base}/`} data-path="" data-t="home">{f.home}</a>
        <a class="btn btn-light btn-lg" href={`${base}/getting-started/installation/`} data-path="getting-started/installation/" data-t="docs">{f.docs}</a>
      </div>
      <ul class="more">
        <li><a href={`${base}/download/`} data-path="download/"><span data-t="download">{f.download}</span> →</a></li>
        <li><a href={`${base}/getting-started/first-launch/`} data-path="getting-started/first-launch/"><span data-t="start">{f.start}</span> →</a></li>
        <li><a href={`${base}/forgy/assistant/`} data-path="forgy/assistant/"><span data-t="forgy">{f.forgy}</span> →</a></li>
        <li><a href={issue}><span data-t="report">{f.report}</span> →</a></li>
      </ul>
    </div>
    <div class="art">
      <svg width="280" height="280" viewBox="0 0 100 100" role="img" aria-label={f.sleeping} data-t-label="sleeping">
        <rect x="48.5" y="14" width="3" height="16" rx="1.5" fill="#AEB3C0"></rect>
        <circle cx="50" cy="13" r="4.6" fill="#8A6A50"></circle>
        <rect x="8" y="50" width="9" height="16" rx="4" fill="#C9CDD8"></rect>
        <rect x="83" y="50" width="9" height="16" rx="4" fill="#C9CDD8"></rect>
        <rect x="14" y="28" width="72" height="62" rx="26" fill="#E6E8EE"></rect>
        <rect x="24" y="42" width="52" height="30" rx="14" fill="#1C2130"></rect>
        <path d="M33 58 H45" stroke="#8A6A50" stroke-width="4" stroke-linecap="round"></path>
        <path d="M55 58 H67" stroke="#8A6A50" stroke-width="4" stroke-linecap="round"></path>
        <text x="72" y="22" font-size="14" font-weight="700" fill="#8A877F">z</text>
        <text x="81" y="13" font-size="11" font-weight="700" fill="#8A877F">z</text>
      </svg>
    </div>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <span data-t="made">{f.made}</span>
      <span class="quiet" data-t="privacy">{f.privacy}</span>
    </div>
  </footer>

  <script is:inline define:vars={{ en, base }}>
    // Under /en/: English texts and links
    if (location.pathname.startsWith(base + '/en/')) {
      const t = JSON.parse(en)
      document.documentElement.lang = 'en'
      document.title = t.title
      document.querySelectorAll('[data-t]').forEach(el => { el.textContent = t[el.dataset.t] })
      document.querySelectorAll('[data-t-label]').forEach(el => el.setAttribute('aria-label', t[el.dataset.tLabel]))
      document.querySelectorAll('[data-path]').forEach(a => { a.href = base + '/en/' + a.dataset.path })
      document.querySelector('[data-home-link]').href = base + '/en/'
      document.querySelector('[data-other]').href = base + '/'
    }
  </script>

  <style is:global>
    :root {
      --paper: #F6F4EF; --white: #FFFFFF; --ink: #17191E; --ink-2: #4A505C; --ink-3: #6E7480; --rule: #E2DED6; --rule-2: #D6D1C8;
      --link: #1D4ED8; --orange: #C2530A;
      --font: 'Geist Variable', 'Segoe UI', system-ui, sans-serif; --mono: 'Geist Mono Variable', ui-monospace, monospace;
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; background: var(--paper); color: var(--ink); font: 17px/1.6 var(--font); -webkit-font-smoothing: antialiased; }
    a { color: var(--link); }
    .wrap { width: min(1200px, 100% - 48px); margin-inline: auto; }
    .btn { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; font-weight: 600; border-radius: 10px; border: 1px solid transparent; }
    .btn-sm { padding: 9px 16px; font-size: 15px; border-radius: 8px; }
    .btn-lg { padding: 13px 22px; min-height: 48px; font-size: 16px; }
    .btn-dark { background: var(--ink); color: #fff; }
    .btn-dark:hover { background: #2B2F37; color: #fff; }
    .btn-light { background: var(--white); color: var(--ink); border-color: var(--rule-2); }
    .top { border-bottom: 1px solid var(--rule); }
    .top-inner { display: flex; align-items: center; height: 68px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 700; font-size: 18px; }
    .brand-mark { width: 30px; height: 30px; border-radius: 8px; background: #0F1117; display: inline-flex; align-items: center; justify-content: center; }
    .top-end { margin-left: auto; display: flex; align-items: center; gap: 16px; }
    .lang { color: var(--ink-3); text-decoration: none; font: 600 13px var(--mono); }
    .main { flex: 1; display: flex; flex-wrap: wrap; gap: 64px; align-items: center; padding-block: 96px; }
    .text { flex: 1 1 520px; min-width: 0; }
    .kicker { margin: 0; font: 600 15px var(--mono); color: var(--orange); }
    h1 { margin: 12px 0 0; font-size: clamp(38px, 5vw, 60px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 760; }
    .lead { margin: 20px 0 0; font-size: 19px; color: var(--ink-2); max-width: 32em; }
    .actions { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px; }
    .more { margin: 40px 0 0; padding: 24px 0 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px 28px; border-top: 1px solid var(--rule); font-size: 15px; }
    .more a { text-decoration: none; font-weight: 600; }
    .more a:hover { text-decoration: underline; }
    .art { flex: 1 1 280px; min-width: 0; display: flex; justify-content: center; }
    .art svg { max-width: 100%; height: auto; font-family: var(--font); }
    .foot { border-top: 1px solid var(--rule); }
    .foot-inner { padding: 24px 0 32px; display: flex; flex-wrap: wrap; gap: 10px 24px; font-size: 14px; color: var(--ink-2); }
    .quiet { margin-left: auto; color: var(--ink-3); }
    @media (max-width: 600px) { .main { padding-block: 56px; } .art svg { width: 180px; } }
  </style>
</body>
</html>
