---
/**
 * The home page of the site, styled like the app itself (Geist, the dark
 * canvas, the blue accent and Forgy's orange from src/renderer/src/styles).
 */
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import { Image } from 'astro:assets'
import {
  Activity, ArrowRight, Bot, Check, ChevronRight, HardDriveDownload, HeartPulse,
  RadioTower, ShieldCheck, Terminal, CloudUpload, Workflow, Download as DownloadIcon, Lock, Plug, CodeXml
} from '@lucide/astro'
import Forgy from './Forgy.astro'
import Logo from '../../assets/logo.svg'
import { TEXT, type Lang } from './text'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = TEXT[lang]
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const docs = (path: string) => `${base}/${lang === 'en' ? 'en/' : ''}${path}`
const otherHome = `${base}/${lang === 'en' ? '' : 'en/'}`

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*.png', { eager: true })
const shot = (id: string) => images[`../../assets/screens/${id}-${lang}.png`].default

const serverIcons = { terminal: Terminal, heart: HeartPulse, backup: HardDriveDownload, deploy: CloudUpload, workflow: Workflow, shield: ShieldCheck, radio: RadioTower, activity: Activity }
const privacyIcons = [Plug, Lock, CodeXml]
const releases = 'https://github.com/victhille/devforge/releases/latest'
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.title}</title>
  <meta name="description" content={t.description} />
  <meta property="og:title" content={t.title} />
  <meta property="og:description" content={t.description} />
  <meta name="theme-color" content="#0D0F13" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="alternate" hreflang={lang === 'en' ? 'fr' : 'en'} href={otherHome} />
</head>
<body>
  <a class="skip" href="#main">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>

  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href={`${base}/${lang === 'en' ? 'en/' : ''}`} aria-label="DevForge">
        <img src={Logo.src} alt="" width="28" height="28" />
        <span>DevForge</span>
      </a>
      <nav class="nav-links" aria-label="Menu">
        <a href="#features">{t.nav.features}</a>
        <a href="#servers">{t.nav.servers}</a>
        <a href="#forgy">{t.nav.forgy}</a>
        <a href={docs('getting-started/installation/')}>{t.nav.docs}</a>
      </nav>
      <div class="nav-actions">
        <a class="icon-link" href="https://github.com/victhille/devforge" aria-label="GitHub"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg></a>
        <a class="lang" href={otherHome} hreflang={lang === 'en' ? 'fr' : 'en'} aria-label={t.nav.other}>{t.nav.otherShort}</a>
        <a class="btn btn-primary btn-sm" href={docs('download/')}>{t.nav.download}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="glow glow-blue" aria-hidden="true"></div>
      <div class="glow glow-orange" aria-hidden="true"></div>
      <div class="wrap hero-text">
        <p class="pill"><span class="dot"></span>{t.hero.eyebrow}</p>
        <h1>{t.hero.title[0]}<br /><span class="grad">{t.hero.title[1]}</span></h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="cta-row" data-download data-lang={lang}>
          <a class="btn btn-primary btn-lg" href={releases} data-link>
            <DownloadIcon size={18} /> <span>{t.nav.download}</span>
          </a>
          <a class="btn btn-ghost btn-lg" href={docs('getting-started/installation/')}>{t.hero.secondary} <ArrowRight size={16} /></a>
        </div>
        <p class="release" data-meta aria-live="polite">&nbsp;</p>
        <p class="note">{t.hero.note} <a href={docs(`getting-started/installation/${lang === 'en' ? '#the-smartscreen-warning' : '#lalerte-smartscreen'}`)}>{t.hero.noteLink}</a></p>
      </div>

      <!-- The app, in its window -->
      <div class="wrap">
        <div class="showcase" data-showcase>
          <div class="tabs" role="tablist" aria-label="DevForge">
            {t.shots.map((s, i) => (
              <button role="tab" type="button" id={`tab-${s.id}`} aria-controls={`shot-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={s.id}>{s.label}</button>
            ))}
          </div>
          <div class="window">
            <div class="window-body">
              {t.shots.map((s, i) => (
                <figure role="tabpanel" id={`shot-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0} data-panel={s.id}>
                  <Image src={shot(s.id)} alt={s.caption} widths={[640, 960, 1280]} sizes="(max-width: 1200px) 100vw, 1120px" loading={i === 0 ? 'eager' : 'lazy'} />
                </figure>
              ))}
            </div>
          </div>
          <p class="caption" data-caption aria-live="polite">{t.shots[0].caption}</p>
          <template data-captions>{JSON.stringify(Object.fromEntries(t.shots.map(s => [s.id, s.caption])))}</template>
        </div>
      </div>
    </section>

    <!-- Facts -->
    <section class="wrap stats" aria-label="DevForge">
      {t.stats.map(s => (
        <div class="stat"><strong>{s.value}</strong><span>{s.label}</span></div>
      ))}
    </section>

    <!-- Features -->
    <section id="features" class="section">
      <div class="wrap">
        <header class="section-head">
          <h2>{t.featuresTitle}</h2>
          <p>{t.featuresLead}</p>
        </header>
        {t.features.map((f, i) => (
          <article class={`feature ${i % 2 ? 'reverse' : ''}`}>
            <div class="feature-text">
              <p class="kicker">{f.kicker}</p>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
              <ul class="checks">
                {f.points.map(p => <li><Check size={16} /> {p}</li>)}
              </ul>
              <a class="more" href={docs(f.link)}>{t.nav.docs} <ChevronRight size={15} /></a>
            </div>
            <div class="feature-shot">
              <Image src={shot(f.shot)} alt={f.title} widths={[640, 960]} sizes="(max-width: 900px) 100vw, 640px" loading="lazy" />
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Servers -->
    <section id="servers" class="section alt">
      <div class="wrap">
        <header class="section-head">
          <h2>{t.serversTitle}</h2>
          <p>{t.serversLead}</p>
        </header>
        <div class="cards">
          {t.servers.map(s => {
            const Icon = serverIcons[s.icon as keyof typeof serverIcons]
            return (
              <a class="card" href={docs(s.link)}>
                <span class="card-icon"><Icon size={20} /></span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </a>
            )
          })}
        </div>
      </div>
    </section>

    <!-- Forgy -->
    <section id="forgy" class="section forgy-section">
      <div class="wrap forgy-grid">
        <div class="forgy-text">
          <div class="forgy-head"><Forgy size={72} /><p class="kicker kicker-forgy">{t.forgy.kicker}</p></div>
          <h2>{t.forgy.title}</h2>
          <p>{t.forgy.text}</p>
          <ul class="checks checks-forgy">
            {t.forgy.points.map(p => <li><Check size={16} /> {p}</li>)}
          </ul>
          <a class="btn btn-forgy" href={docs('forgy/assistant/')}><Bot size={17} /> {t.forgy.link}</a>
        </div>

        <!-- Forgy's panel, as in the app -->
        <div class="panel" aria-hidden="true">
          <div class="panel-head">
            <Forgy size={40} />
            <div><strong>{t.forgy.mock.name}</strong><span>{t.forgy.mock.status}</span></div>
          </div>
          <div class="panel-body">
            <p class="bubble-user">{t.forgy.mock.question}</p>
            <p class="bubble-forgy">{t.forgy.mock.answer}</p>
            <div class="action">
              <div class="action-title"><Check size={14} /> {t.forgy.mock.cardTitle}</div>
              <code>{t.forgy.mock.cardMessage}</code>
              <p>{t.forgy.mock.cardNote}</p>
              <div class="action-buttons"><span class="a-approve">{t.forgy.mock.approve}</span><span class="a-refuse">{t.forgy.mock.refuse}</span></div>
            </div>
          </div>
          <div class="panel-foot"><span>{t.forgy.mock.cost}</span></div>
        </div>
      </div>
    </section>

    <!-- Keyboard -->
    <section class="section">
      <div class="wrap feature">
        <div class="feature-text">
          <p class="kicker">{t.palette.kicker}</p>
          <h3>{t.palette.title}</h3>
          <p>{t.palette.text}</p>
          <ul class="keys">
            {t.palette.keys.map(k => (
              <li><span>{k.slice(0, -1).map(key => <kbd>{key}</kbd>)}</span>{k[k.length - 1]}</li>
            ))}
          </ul>
        </div>
        <div class="feature-shot">
          <Image src={shot('palette')} alt={t.palette.title} widths={[640, 960]} sizes="(max-width: 900px) 100vw, 640px" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- Privacy -->
    <section class="section alt">
      <div class="wrap">
        <header class="section-head"><h2>{t.privacy.title}</h2></header>
        <div class="cards cards-3">
          {t.privacy.items.map((p, i) => {
            const Icon = privacyIcons[i]
            return (
              <div class="card static">
                <span class="card-icon"><Icon size={20} /></span>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            )
          })}
        </div>
      </div>
    </section>

    <!-- All pages -->
    <section class="section">
      <div class="wrap">
        <header class="section-head">
          <h2>{t.allTitle}</h2>
          <p>{t.allLead}</p>
        </header>
        <div class="groups">
          {t.groups.map(g => (
            <div class="group">
              <h3>{g.name}</h3>
              <ul>{g.pages.map(([label, link]) => <li><a href={docs(link)}>{label}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Download -->
    <section class="wrap final">
      <div class="final-card">
        <div class="glow glow-blue small" aria-hidden="true"></div>
        <img src={Logo.src} alt="" width="64" height="64" />
        <h2>{t.cta.title}</h2>
        <p>{t.cta.text}</p>
        <div class="cta-row center" data-download data-lang={lang}>
          <a class="btn btn-primary btn-lg" href={releases} data-link><DownloadIcon size={18} /> <span>{t.nav.download}</span></a>
          <a class="btn btn-ghost btn-lg" href={docs('getting-started/installation/')}>{t.cta.docs} <ArrowRight size={16} /></a>
        </div>
        <p class="release" data-meta aria-live="polite">&nbsp;</p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <span class="brand small"><img src={Logo.src} alt="" width="20" height="20" /> DevForge</span>
      <nav>
        <a href={docs('getting-started/installation/')}>{t.footer.docs}</a>
        <a href={docs('developers/')}>{t.footer.developers}</a>
        <a href="https://github.com/victhille/devforge/releases">{t.footer.releases}</a>
        <a href="https://github.com/victhille/devforge">GitHub</a>
        <a href="https://github.com/victhille/devforge/blob/main/LICENSE">{t.footer.license}</a>
        <a href={otherHome} hreflang={lang === 'en' ? 'fr' : 'en'}>{t.nav.other}</a>
      </nav>
      <p>{t.footer.privacy}</p>
    </div>
  </footer>

  <script>
    // The latest release: version, size and the installer itself (no version written in the page)
    const API = 'https://api.github.com/repos/victhille/devforge/releases/latest'
    const INSTALLER = /^DevForge-Setup-v.+\.exe$/
    interface Release { tag_name: string; published_at: string; assets: { name: string; size: number; browser_download_url: string }[] }
    const boxes = [...document.querySelectorAll<HTMLElement>('[data-download]')]
    fetch(API, { headers: { Accept: 'application/vnd.github+json' } })
      .then(r => (r.ok ? (r.json() as Promise<Release>) : null))
      .catch(() => null)
      .then(r => {
        const exe = r?.assets.find(a => INSTALLER.test(a.name))
        if (!r || !exe) return
        for (const box of boxes) {
          const fr = box.dataset.lang !== 'en'
          box.querySelector<HTMLAnchorElement>('[data-link]')!.href = exe.browser_download_url
          const date = new Date(r.published_at).toLocaleDateString(fr ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
          const meta = box.nextElementSibling
          if (meta?.hasAttribute('data-meta')) meta.textContent = `${r.tag_name} · ${Math.round(exe.size / 1048576)} ${fr ? 'Mo' : 'MB'} · ${date}`
        }
      })

    // Screenshot tabs: click or arrow keys; turns by itself until someone picks one
    const show = document.querySelector<HTMLElement>('[data-showcase]')
    if (show) {
      const tabs = [...show.querySelectorAll<HTMLButtonElement>('[data-tab]')]
      const panels = [...show.querySelectorAll<HTMLElement>('[data-panel]')]
      const caption = show.querySelector<HTMLElement>('[data-caption]')!
      const captions = JSON.parse(show.querySelector('template')!.innerHTML) as Record<string, string>
      let current = 0
      const select = (i: number, focus = false) => {
        current = (i + tabs.length) % tabs.length
        tabs.forEach((tab, k) => { tab.setAttribute('aria-selected', String(k === current)); tab.tabIndex = k === current ? 0 : -1 })
        panels.forEach((p, k) => { p.hidden = k !== current })
        caption.textContent = captions[tabs[current].dataset.tab!]
        if (focus) tabs[current].focus()
      }
      let timer: ReturnType<typeof setInterval> | undefined
      const stop = () => { clearInterval(timer); timer = undefined }
      tabs.forEach((tab, i) => tab.addEventListener('click', () => { stop(); select(i) }))
      show.querySelector('[role=tablist]')!.addEventListener('keydown', e => {
        const k = (e as KeyboardEvent).key
        if (k === 'ArrowRight' || k === 'ArrowLeft') { e.preventDefault(); stop(); select(current + (k === 'ArrowRight' ? 1 : -1), true) }
      })
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        timer = setInterval(() => select(current + 1), 5000)
        show.addEventListener('pointerenter', stop, { once: true })
      }
    }
  </script>

  <style is:global>
    :root {
      --bg: #0D0F13; --surface: #161A21; --elevated: #1D222B; --sidebar: #111419; --chrome: #0A0C10;
      --line: #262C36; --line-subtle: #1F242D;
      --fg: #E8ECF2; --fg-2: #9AA4B2; --fg-3: #8792A2;
      --accent: #5B9BFF; --accent-hover: #7EB0FF; --accent-dim: rgba(91, 155, 255, .13); --accent-fg: #08111F;
      --success: #3FCF8E; --forgy: #FF9A3C; --forgy-dim: rgba(255, 154, 60, .12); --forgy-fg: #1A0E04;
      --font: 'Geist Variable', system-ui, sans-serif; --mono: 'Geist Mono Variable', ui-monospace, monospace;
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.6 var(--font); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    a { color: inherit; }
    img { max-width: 100%; height: auto; display: block; }
    h1, h2, h3 { margin: 0; letter-spacing: -.025em; line-height: 1.12; }
    p { margin: 0; }
    .wrap { width: min(1180px, 100% - 32px); margin-inline: auto; }
    .skip { position: absolute; left: -9999px; }
    .skip:focus { left: 16px; top: 12px; z-index: 100; background: var(--accent); color: var(--accent-fg); padding: 8px 12px; border-radius: 8px; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }

    /* Buttons, like the app's */
    .btn { display: inline-flex; align-items: center; gap: 8px; border-radius: 10px; font-weight: 600; text-decoration: none; border: 1px solid transparent; transition: background .15s, border-color .15s, transform .15s; white-space: nowrap; }
    .btn-sm { padding: 7px 14px; font-size: 14px; }
    .btn-lg { padding: 13px 22px; font-size: 16px; }
    .btn-primary { background: var(--accent); color: var(--accent-fg); }
    .btn-primary:hover { background: var(--accent-hover); }
    .btn-ghost { background: var(--surface); border-color: var(--line); color: var(--fg); }
    .btn-ghost:hover { border-color: #3A4250; background: var(--elevated); }
    .btn-forgy { background: var(--forgy-dim); border-color: rgba(255, 154, 60, .35); color: var(--forgy); padding: 11px 18px; margin-top: 28px; }
    .btn-forgy:hover { background: rgba(255, 154, 60, .2); }
    .btn:active { transform: translateY(1px); }

    /* Header */
    .nav { position: sticky; top: 0; z-index: 50; background: rgba(13, 15, 19, .78); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line-subtle); }
    .nav-inner { display: flex; align-items: center; gap: 24px; height: 64px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 17px; text-decoration: none; }
    .brand.small { font-size: 15px; gap: 8px; }
    .nav-links { display: flex; gap: 4px; margin-left: 12px; }
    .nav-links a { color: var(--fg-2); text-decoration: none; font-size: 14.5px; padding: 6px 10px; border-radius: 8px; }
    .nav-links a:hover { color: var(--fg); background: var(--surface); }
    .nav-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
    .icon-link, .lang { display: inline-flex; align-items: center; justify-content: center; height: 34px; min-width: 34px; padding: 0 8px; border-radius: 8px; color: var(--fg-2); text-decoration: none; font: 600 13px var(--mono); }
    .icon-link:hover, .lang:hover { color: var(--fg); background: var(--surface); }

    /* Hero */
    .hero { position: relative; padding: 88px 0 40px; overflow: hidden; }
    .hero::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(var(--line-subtle) 1px, transparent 1px), linear-gradient(90deg, var(--line-subtle) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000 30%, transparent 75%); opacity: .55; pointer-events: none; }
    .glow { position: absolute; border-radius: 50%; filter: blur(90px); pointer-events: none; }
    .glow-blue { width: 620px; height: 420px; background: rgba(91, 155, 255, .22); top: 260px; left: 50%; transform: translateX(-70%); }
    .glow-orange { width: 420px; height: 320px; background: rgba(255, 154, 60, .14); top: 380px; left: 50%; transform: translateX(10%); }
    .glow.small { width: 420px; height: 260px; top: -60px; left: 50%; transform: translateX(-50%); }
    .hero-text { position: relative; text-align: center; display: flex; flex-direction: column; align-items: center; }
    .pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border: 1px solid var(--line); border-radius: 999px; background: rgba(22, 26, 33, .8); color: var(--fg-2); font: 500 13px var(--mono); }
    .pill .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 10px var(--success); }
    .hero h1 { margin-top: 26px; font-size: clamp(38px, 6.4vw, 72px); font-weight: 700; letter-spacing: -.04em; }
    .grad { background: linear-gradient(95deg, var(--accent) 10%, #A9C8FF 55%, var(--forgy) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .lead { margin-top: 22px; max-width: 680px; color: var(--fg-2); font-size: clamp(16px, 2vw, 19px); }
    .cta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 34px; }
    .release { margin-top: 14px; color: var(--fg-3); font: 13px var(--mono); min-height: 1.6em; }
    .note { color: var(--fg-3); font-size: 13px; }
    .note a { color: var(--fg-2); }

    /* The app's window */
    .showcase { position: relative; margin-top: 56px; }
    .tabs { display: flex; gap: 4px; justify-content: center; flex-wrap: wrap; margin-bottom: 18px; }
    .tabs button { font: 500 14px var(--font); color: var(--fg-2); background: transparent; border: 1px solid transparent; padding: 7px 14px; border-radius: 999px; cursor: pointer; }
    .tabs button:hover { color: var(--fg); background: var(--surface); }
    .tabs button[aria-selected='true'] { color: var(--fg); background: var(--accent-dim); border-color: rgba(91, 155, 255, .35); }
    .window { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--chrome); box-shadow: 0 40px 120px -30px rgba(0, 0, 0, .9), 0 0 0 1px rgba(255, 255, 255, .02) inset; }
    .window-body figure { margin: 0; }
    .window-body figure img { width: 100%; }
    .caption { margin-top: 16px; text-align: center; color: var(--fg-2); font-size: 14.5px; min-height: 1.6em; }

    /* Facts */
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line-subtle); border: 1px solid var(--line-subtle); border-radius: 14px; overflow: hidden; margin-top: 64px; }
    .stat { background: var(--bg); padding: 26px 24px; display: flex; flex-direction: column; gap: 4px; }
    .stat strong { font-size: 30px; letter-spacing: -.03em; }
    .stat span { color: var(--fg-2); font-size: 14px; }

    /* Sections */
    .section { padding: 110px 0; scroll-margin-top: 40px; }
    .section.alt { background: linear-gradient(180deg, var(--sidebar), var(--bg)); border-block: 1px solid var(--line-subtle); }
    .section-head { max-width: 720px; margin-bottom: 56px; }
    .section-head h2, .forgy-text h2, .final-card h2 { font-size: clamp(28px, 4vw, 44px); font-weight: 700; }
    .section-head p { margin-top: 16px; color: var(--fg-2); font-size: 18px; }
    .kicker { font: 600 13px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent); margin-bottom: 14px; }
    .kicker-forgy { color: var(--forgy); margin: 0; }

    .feature { display: grid; grid-template-columns: 1fr 1.25fr; gap: 64px; align-items: center; }
    .feature + .feature { margin-top: 110px; }
    .feature.reverse .feature-text { order: 2; }
    .feature h3 { font-size: clamp(24px, 3vw, 32px); font-weight: 700; }
    .feature-text > p:not(.kicker) { margin-top: 16px; color: var(--fg-2); font-size: 17px; }
    .feature-shot { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, .8); }
    .checks { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 10px; }
    .checks li { display: flex; gap: 10px; align-items: flex-start; font-size: 15.5px; }
    .checks svg { flex: none; margin-top: 4px; color: var(--success); }
    .checks-forgy svg { color: var(--forgy); }
    .more { display: inline-flex; align-items: center; gap: 4px; margin-top: 24px; color: var(--accent); text-decoration: none; font-weight: 600; font-size: 15px; }
    .more:hover { color: var(--accent-hover); }

    .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .cards-3 { grid-template-columns: repeat(3, 1fr); }
    .card { display: block; padding: 22px; border: 1px solid var(--line-subtle); border-radius: 14px; background: var(--surface); text-decoration: none; transition: border-color .15s, transform .15s, background .15s; }
    a.card:hover { border-color: rgba(91, 155, 255, .45); background: var(--elevated); transform: translateY(-2px); }
    .card-icon { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; border-radius: 10px; background: var(--accent-dim); color: var(--accent); margin-bottom: 16px; }
    .card h3 { font-size: 17px; }
    .card p { margin-top: 8px; color: var(--fg-2); font-size: 14.5px; }

    /* Forgy */
    .forgy-section { position: relative; background: radial-gradient(ellipse 60% 70% at 85% 50%, rgba(255, 154, 60, .10), transparent 70%); }
    .forgy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
    .forgy-head { display: flex; align-items: center; gap: 16px; margin-bottom: 18px; }
    .forgy-head .forgy { animation: float 4.5s ease-in-out infinite; }
    .forgy-text > p { margin-top: 18px; color: var(--fg-2); font-size: 17px; }
    @keyframes float { 50% { transform: translateY(-6px); } }
    @media (prefers-reduced-motion: reduce) { .forgy-head .forgy { animation: none; } }
    .panel { border: 1px solid var(--line); border-radius: 16px; background: var(--sidebar); box-shadow: 0 40px 100px -30px rgba(0, 0, 0, .9), 0 0 0 1px rgba(255, 154, 60, .08); overflow: hidden; }
    .panel-head { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--line-subtle); }
    .panel-head div { display: flex; flex-direction: column; }
    .panel-head strong { font-size: 15px; }
    .panel-head span { font-size: 12.5px; color: var(--fg-3); }
    .panel-body { padding: 20px 18px; display: flex; flex-direction: column; gap: 14px; }
    .bubble-user { align-self: flex-end; background: var(--accent-dim); border: 1px solid rgba(91, 155, 255, .25); padding: 10px 14px; border-radius: 14px 14px 4px 14px; font-size: 14.5px; }
    .bubble-forgy { color: var(--fg); font-size: 14.5px; }
    .action { border: 1px solid rgba(255, 154, 60, .35); background: var(--forgy-dim); border-radius: 12px; padding: 14px; }
    .action-title { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; color: var(--forgy); }
    .action code { display: block; margin-top: 10px; padding: 9px 11px; border-radius: 8px; background: var(--chrome); border: 1px solid var(--line-subtle); font: 13px var(--mono); }
    .action p { margin-top: 10px; font-size: 12.5px; color: var(--fg-2); }
    .action-buttons { display: flex; gap: 8px; margin-top: 12px; }
    .action-buttons span { font-size: 13px; font-weight: 600; padding: 6px 14px; border-radius: 8px; }
    .a-approve { background: var(--forgy); color: var(--forgy-fg); }
    .a-refuse { background: var(--surface); border: 1px solid var(--line); }
    .panel-foot { padding: 10px 18px; border-top: 1px solid var(--line-subtle); font: 12px var(--mono); color: var(--fg-3); }

    /* Keyboard */
    .keys { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 10px; }
    .keys li { display: flex; align-items: center; gap: 14px; color: var(--fg-2); font-size: 15px; }
    .keys li > span { display: inline-flex; gap: 4px; min-width: 150px; }
    kbd { font: 600 12.5px var(--mono); color: var(--fg); padding: 3px 8px; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 6px; background: var(--surface); }

    /* All pages */
    .groups { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .group { padding: 22px; border: 1px solid var(--line-subtle); border-radius: 14px; background: var(--surface); }
    .group h3 { font: 600 13px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--fg-3); }
    .group ul { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 6px; }
    .group a { text-decoration: none; color: var(--fg); font-size: 15px; }
    .group a:hover { color: var(--accent); }

    /* Final call */
    .final { padding: 40px 0 110px; }
    .final-card { position: relative; overflow: hidden; text-align: center; padding: 64px 24px; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); display: flex; flex-direction: column; align-items: center; }
    .final-card > * { position: relative; }
    .final-card > p { margin-top: 14px; color: var(--fg-2); font-size: 17px; }
    .final-card h2 { margin-top: 22px; }
    .cta-row.center { margin-top: 28px; }

    .footer { border-top: 1px solid var(--line-subtle); padding: 32px 0 40px; color: var(--fg-3); font-size: 14px; }
    .footer-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; }
    .footer nav { display: flex; flex-wrap: wrap; gap: 6px 18px; }
    .footer nav a { color: var(--fg-2); text-decoration: none; }
    .footer nav a:hover { color: var(--fg); }
    .footer p { width: 100%; }

    @media (max-width: 960px) {
      .nav-links { display: none; }
      .feature, .forgy-grid { grid-template-columns: 1fr; gap: 36px; }
      .feature.reverse .feature-text { order: 0; }
      .cards { grid-template-columns: repeat(2, 1fr); }
      .cards-3, .groups { grid-template-columns: 1fr 1fr; }
      .stats { grid-template-columns: 1fr 1fr; }
      .section { padding: 80px 0; }
    }
    @media (max-width: 600px) {
      .cards, .cards-3, .groups { grid-template-columns: 1fr; }
      .hero { padding-top: 56px; }
      .tabs { justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -16px; padding-inline: 16px; }
      .btn-lg { padding: 12px 18px; }
      .nav-actions .btn { display: none; }
      .stat strong { font-size: 24px; }
    }
  </style>
</body>
</html>
