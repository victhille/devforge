---
/**
 * The home page of the site: a plain product page in the spirit of
 * independent Windows/Mac software sites (a light page, the app's real
 * screens on its own dark canvas, written paragraphs, a FAQ).
 */
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import { Image } from 'astro:assets'
import Forgy from './Forgy.astro'
import Logo from '../../assets/logo.svg'
import { TEXT, type Lang } from './text'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = TEXT[lang]
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const home = `${base}/${lang === 'en' ? 'en/' : ''}`
const docs = (path: string) => `${home}${path}`
const otherHome = `${base}/${lang === 'en' ? '' : 'en/'}`

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*.png', { eager: true })
const shot = (id: string) => images[`../../assets/screens/${id}-${lang}.png`].default
const releases = 'https://github.com/victhille/devforge/releases/latest'
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.title}</title>
  <meta name="description" content={t.description} />
  <meta property="og:title" content={t.title} />
  <meta property="og:description" content={t.description} />
  <meta name="theme-color" content="#FAF9F7" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="alternate" hreflang={lang === 'en' ? 'fr' : 'en'} href={otherHome} />
</head>
<body>
  <a class="skip" href="#main">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>

  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href={home}><img src={Logo.src} alt="" width="26" height="26" /> DevForge</a>
      <nav class="links" aria-label="Menu">
        <a href="#tour">{t.nav.tour}</a>
        <a href="#servers">{t.nav.servers}</a>
        <a href="#forgy">{t.nav.forgy}</a>
        <a href="#faq">{t.nav.faq}</a>
        <a href={docs('getting-started/installation/')}>{t.nav.docs}</a>
      </nav>
      <div class="top-end">
        <a class="lang" href={otherHome} hreflang={lang === 'en' ? 'fr' : 'en'} title={t.nav.other}>{t.nav.otherShort}</a>
        <a class="button small" href={docs('download/')}>{t.nav.download}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="wrap hero">
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="get" data-download data-lang={lang}>
        <a class="button" href={releases} data-link>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.1 10.4 4v7.2H3V5.1Zm0 13.8 7.4 1.1v-7.1H3v6Zm8.2 1.2L21 21.5v-8.6h-9.8v7.2Zm0-16.2v7.3H21V2.5l-9.8 1.4Z"/></svg>
          {t.hero.download}
        </a>
        <p class="get-info"><span>{t.hero.requirements}</span> <span class="ver" data-meta></span></p>
      </div>
      <a class="text-link" href={docs('getting-started/installation/')}>{t.hero.secondary} →</a>
    </section>

    <figure class="stage">
      <div class="wrap">
        <Image class="screen" src={shot('home')} alt={t.heroCaption} widths={[800, 1280]} sizes="(max-width: 1240px) 100vw, 1200px" loading="eager" />
        <figcaption>{t.heroCaption}</figcaption>
      </div>
    </figure>

    <section class="wrap why">
      <h2>{t.why.title}</h2>
      <div>{t.why.paragraphs.map(p => <p>{p}</p>)}</div>
    </section>

    <section id="tour" class="wrap tour">
      {t.tour.map((f, i) => (
        <article class={`step ${i % 2 ? 'flip' : ''}`}>
          <div class="step-text">
            <h2>{f.title}</h2>
            <p>{f.text}</p>
            <a class="text-link" href={docs(f.link)}>{t.nav.docs} →</a>
          </div>
          <Image class="screen" src={shot(f.shot)} alt={f.title} widths={[640, 960]} sizes="(max-width: 900px) 100vw, 720px" loading="lazy" />
        </article>
      ))}
      <div class="trio">
        {t.small.map(s => (
          <a class="mini" href={docs(s.link)}>
            <Image class="screen" src={shot(s.shot)} alt="" widths={[480]} sizes="380px" loading="lazy" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="servers" class="dark">
      <div class="wrap">
        <h2>{t.servers.title}</h2>
        <p class="dark-lead">{t.servers.lead}</p>
        <dl class="specs">
          {t.servers.items.map(([title, text, link]) => (
            <div>
              <dt><a href={docs(link)}>{title}</a></dt>
              <dd>{text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="forgy" class="wrap forgy">
      <div class="forgy-text">
        <Forgy size={64} />
        <h2>{t.forgy.title}</h2>
        {t.forgy.paragraphs.map(p => <p>{p}</p>)}
        <a class="text-link" href={docs('forgy/assistant/')}>{t.forgy.link} →</a>
      </div>
      <div class="panel" aria-hidden="true">
        <div class="panel-head"><Forgy size={34} /><div><strong>Forgy</strong><span>{t.forgy.mock.status}</span></div></div>
        <div class="panel-body">
          <p class="q">{t.forgy.mock.question}</p>
          <p>{t.forgy.mock.answer}</p>
          <div class="card">
            <strong>{t.forgy.mock.cardTitle}</strong>
            <code>{t.forgy.mock.cardMessage}</code>
            <small>{t.forgy.mock.cardNote}</small>
            <div class="card-buttons"><span class="ok">{t.forgy.mock.approve}</span><span>{t.forgy.mock.refuse}</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap keys">
      <h2>{t.keys.title}</h2>
      <table>
        <tbody>
          {t.keys.items.map(([combo, what]) => (
            <tr><td>{combo.split(' ').map(k => <kbd>{k}</kbd>)}</td><td>{what}</td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section id="faq" class="wrap faq">
      <h2>{t.faq.title}</h2>
      <div>
        {t.faq.items.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="wrap end">
      <h2>{t.end.title}</h2>
      <p>{t.end.text}</p>
      <div class="get" data-download data-lang={lang}>
        <a class="button" href={releases} data-link>{t.hero.download}</a>
        <p class="get-info"><span>{t.hero.requirements}</span> <span class="ver" data-meta></span></p>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <p><img src={Logo.src} alt="" width="18" height="18" /> DevForge · {t.footer.made}</p>
      <nav>
        <a href={docs('getting-started/installation/')}>{t.footer.docs}</a>
        <a href={docs('developers/')}>{t.footer.developers}</a>
        <a href="https://github.com/victhille/devforge/releases">{t.footer.releases}</a>
        <a href="https://github.com/victhille/devforge">GitHub</a>
        <a href="https://github.com/victhille/devforge/blob/main/LICENSE">{t.footer.license}</a>
        <a href={otherHome} hreflang={lang === 'en' ? 'fr' : 'en'}>{t.nav.other}</a>
      </nav>
      <p class="quiet">{t.footer.privacy}</p>
    </div>
  </footer>

  <script>
    // The latest release: its installer, version and size (no version is written in the page)
    const API = 'https://api.github.com/repos/victhille/devforge/releases/latest'
    const INSTALLER = /^DevForge-Setup-v.+\.exe$/
    interface Release { tag_name: string; published_at: string; assets: { name: string; size: number; browser_download_url: string }[] }
    fetch(API, { headers: { Accept: 'application/vnd.github+json' } })
      .then(r => (r.ok ? (r.json() as Promise<Release>) : null))
      .catch(() => null)
      .then(r => {
        const exe = r?.assets.find(a => INSTALLER.test(a.name))
        if (!r || !exe) return
        for (const box of document.querySelectorAll<HTMLElement>('[data-download]')) {
          const fr = box.dataset.lang !== 'en'
          box.querySelector<HTMLAnchorElement>('[data-link]')!.href = exe.browser_download_url
          const date = new Date(r.published_at).toLocaleDateString(fr ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
          box.querySelector('[data-meta]')!.textContent = `· ${r.tag_name}, ${fr ? 'publiée le' : 'released'} ${date} · ${Math.round(exe.size / 1048576)} ${fr ? 'Mo' : 'MB'}`
        }
      })
  </script>

  <style is:global>
    :root {
      --paper: #FAF9F7; --white: #FFFFFF; --ink: #17191E; --ink-2: #4A505C; --ink-3: #6E7480;
      --rule: #E4E1DB; --link: #1D4ED8;
      --brand: #E8630A;
      --app: #0D0F13; --app-2: #161A21; --app-line: #262C36; --app-fg: #E8ECF2; --app-fg-2: #9AA4B2; --app-blue: #5B9BFF; --forgy: #FF9A3C;
      --font: 'Geist Variable', 'Segoe UI', system-ui, sans-serif; --mono: 'Geist Mono Variable', ui-monospace, monospace;
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 17px/1.65 var(--font); -webkit-font-smoothing: antialiased; }
    img { max-width: 100%; height: auto; display: block; }
    h1, h2, h3 { margin: 0; line-height: 1.15; letter-spacing: -0.02em; font-weight: 650; }
    p { margin: 0; }
    a { color: var(--link); }
    .wrap { width: min(1120px, 100% - 40px); margin-inline: auto; }
    .skip { position: absolute; left: -9999px; }
    .skip:focus { left: 12px; top: 12px; z-index: 10; background: var(--ink); color: #fff; padding: 8px 12px; }
    :focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }

    .button { display: inline-flex; align-items: center; gap: 10px; background: var(--ink); color: #fff; text-decoration: none; font-weight: 600; font-size: 16px; padding: 12px 20px; border-radius: 8px; }
    .button:hover { background: #2B2F37; }
    .button.small { padding: 7px 14px; font-size: 14.5px; }
    .text-link { display: inline-block; font-weight: 550; text-decoration: none; }
    .text-link:hover { text-decoration: underline; text-underline-offset: 3px; }

    .top { background: var(--paper); border-bottom: 1px solid var(--rule); }
    .top-inner { display: flex; align-items: center; gap: 28px; height: 60px; }
    .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 700; font-size: 17px; color: var(--ink); text-decoration: none; }
    .links { display: flex; gap: 22px; }
    .links a { color: var(--ink-2); text-decoration: none; font-size: 15px; }
    .links a:hover { color: var(--ink); }
    .top-end { margin-left: auto; display: flex; align-items: center; gap: 14px; }
    .lang { color: var(--ink-3); font: 600 13px var(--mono); text-decoration: none; }
    .lang:hover { color: var(--ink); }

    .hero { padding: 84px 0 56px; }
    .hero h1 { font-size: clamp(36px, 5.2vw, 60px); max-width: 16ch; letter-spacing: -0.035em; }
    .lead { margin-top: 24px; max-width: 62ch; font-size: 19px; color: var(--ink-2); }
    .get { margin-top: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
    .get-info { color: var(--ink-3); font-size: 14px; }
    .hero .text-link { margin-top: 18px; }

    .stage { margin: 0; background: var(--app); padding: 56px 0 28px; }
    .stage .screen { border-radius: 10px; box-shadow: 0 1px 0 rgba(255,255,255,.06) inset, 0 30px 70px -20px #000; border: 1px solid var(--app-line); }
    .stage figcaption { margin-top: 18px; color: var(--app-fg-2); font-size: 14px; }

    .why { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; padding: 96px 0; border-bottom: 1px solid var(--rule); }
    .why h2 { font-size: 30px; }
    .why p + p { margin-top: 18px; }
    .why p { color: var(--ink-2); font-size: 18px; }

    .tour { padding: 40px 0 96px; }
    .step { display: grid; grid-template-columns: 5fr 7fr; gap: 56px; align-items: center; padding: 72px 0; border-bottom: 1px solid var(--rule); }
    .step.flip .step-text { order: 2; }
    .step h2 { font-size: 30px; }
    .step p { margin: 16px 0 18px; color: var(--ink-2); }
    .tour .screen { border-radius: 8px; border: 1px solid #D9D5CE; box-shadow: 0 18px 40px -22px rgba(23, 25, 30, .45); }

    .trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; padding-top: 72px; }
    .mini { text-decoration: none; color: var(--ink); }
    .mini h3 { margin-top: 18px; font-size: 19px; }
    .mini p { margin-top: 6px; color: var(--ink-2); font-size: 15.5px; }
    .mini:hover h3 { color: var(--link); }

    .dark { background: var(--app); color: var(--app-fg); padding: 96px 0; }
    .dark h2 { font-size: 34px; }
    .dark-lead { margin-top: 14px; max-width: 60ch; color: var(--app-fg-2); font-size: 18px; }
    .specs { margin: 48px 0 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 56px; }
    .specs div { padding: 18px 0; border-top: 1px solid var(--app-line); }
    .specs dt a { color: var(--app-fg); font-weight: 600; text-decoration: none; }
    .specs dt a:hover { color: var(--app-blue); }
    .specs dd { margin: 4px 0 0; color: var(--app-fg-2); font-size: 15.5px; }

    .forgy { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; padding: 104px 0; border-bottom: 1px solid var(--rule); }
    .forgy h2 { margin-top: 18px; font-size: 34px; }
    .forgy-text p { margin-top: 16px; color: var(--ink-2); }
    .forgy-text .text-link { margin-top: 20px; }
    .panel { background: #111419; color: var(--app-fg); border-radius: 12px; border: 1px solid var(--app-line); box-shadow: 0 24px 50px -24px rgba(23, 25, 30, .6); font-size: 14.5px; overflow: hidden; }
    .panel-head { display: flex; gap: 10px; align-items: center; padding: 12px 16px; border-bottom: 1px solid #1F242D; }
    .panel-head div { display: flex; flex-direction: column; line-height: 1.3; }
    .panel-head span { color: var(--app-fg-2); font-size: 12.5px; }
    .panel-body { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
    .q { align-self: flex-end; background: rgba(91, 155, 255, .13); padding: 8px 12px; border-radius: 10px; }
    .card { border: 1px solid rgba(255, 154, 60, .35); background: rgba(255, 154, 60, .08); border-radius: 10px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }
    .card strong { color: var(--forgy); font-size: 13.5px; }
    .card code { font: 13px var(--mono); background: #0A0C10; border: 1px solid #1F242D; border-radius: 6px; padding: 7px 9px; }
    .card small { color: var(--app-fg-2); font-size: 12.5px; }
    .card-buttons { display: flex; gap: 8px; }
    .card-buttons span { font-size: 13px; font-weight: 600; padding: 5px 12px; border-radius: 7px; border: 1px solid var(--app-line); }
    .card-buttons .ok { background: var(--forgy); color: #1A0E04; border-color: var(--forgy); }

    .keys, .faq { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; padding: 88px 0; border-bottom: 1px solid var(--rule); }
    .keys h2, .faq h2 { font-size: 30px; }
    .keys table { border-collapse: collapse; width: 100%; }
    .keys td { padding: 12px 0; border-top: 1px solid var(--rule); color: var(--ink-2); }
    .keys td:first-child { width: 40%; white-space: nowrap; }
    kbd { font: 600 13px var(--mono); color: var(--ink); background: var(--white); border: 1px solid #CFCAC1; border-bottom-width: 2px; border-radius: 5px; padding: 2px 7px; margin-right: 4px; }
    details { border-top: 1px solid var(--rule); padding: 16px 0; }
    details:last-child { border-bottom: 1px solid var(--rule); }
    summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; color: var(--ink-3); font-weight: 400; }
    details[open] summary::after { content: '−'; }
    details p { margin-top: 10px; color: var(--ink-2); max-width: 64ch; }

    .end { padding: 96px 0 104px; }
    .end h2 { font-size: 36px; }
    .end > p { margin-top: 12px; color: var(--ink-2); max-width: 56ch; }

    .foot { border-top: 1px solid var(--rule); padding: 28px 0 40px; font-size: 14.5px; color: var(--ink-2); }
    .foot-inner { display: flex; flex-wrap: wrap; gap: 12px 32px; align-items: center; }
    .foot-inner p:first-child { display: inline-flex; align-items: center; gap: 8px; }
    .foot nav { display: flex; flex-wrap: wrap; gap: 6px 18px; }
    .foot nav a { color: var(--ink-2); text-decoration: none; }
    .foot nav a:hover { color: var(--ink); text-decoration: underline; }
    .quiet { width: 100%; color: var(--ink-3); font-size: 13.5px; }

    @media (max-width: 900px) {
      .links { display: none; }
      .why, .step, .forgy, .keys, .faq { grid-template-columns: 1fr; gap: 28px; }
      .step.flip .step-text { order: 0; }
      .specs, .trio { grid-template-columns: 1fr; }
      .hero { padding-top: 56px; }
      .why, .keys, .faq, .dark, .forgy, .end { padding-block: 64px; }
      .step { padding: 48px 0; }
    }
    @media (max-width: 520px) {
      body { font-size: 16px; }
      .top-end .button { display: none; }
      .keys td:first-child { white-space: normal; }
    }
  </style>
</body>
</html>
