---
/**
 * The home page of the site, from the « Atelier » mock-up: a warm light page
 * with the app's real screens, a day with DevForge, the projects tour, the
 * server band on the app's own dark canvas, Forgy, a FAQ and the download.
 */
import { createHash } from 'node:crypto'
import { readFileSync } from 'node:fs'
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import { Image } from 'astro:assets'
import Forgy from './Forgy.astro'
import { TEXT, type Lang } from './text'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = TEXT[lang]
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const home = `${base}/${lang === 'en' ? 'en/' : ''}`
const docs = (path: string) => `${home}${path}`
const otherHome = `${base}/${lang === 'en' ? '' : 'en/'}`

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*.png', { eager: true })
const shot = (id: string) => images[`../../assets/screens/${id}-${lang}.png`].default
const releases = 'https://github.com/victhille/devforge/releases/latest'
// The French video is the narrated 1080p edit, the English one still the 16:10 captioned screencast
const videoSize = lang === 'fr' ? { width: 1920, height: 1080 } : { width: 1280, height: 800 }
// A new video keeps its name, so its address carries a fingerprint of the file: browsers that cached the old one fetch the new one
const fingerprint = (file: string) => createHash('sha256').update(readFileSync(`public/video/${file}`)).digest('hex').slice(0, 10)
const videoFile = `devforge-${lang}.webm`, posterFile = `devforge-poster-${lang}.webp`
const videoSrc = `${base}/video/${videoFile}?v=${fingerprint(videoFile)}`
const posterSrc = `${base}/video/${posterFile}?v=${fingerprint(posterFile)}`
const winLogo = 'M3 5.1 10.4 4v7.2H3V5.1Zm0 13.8 7.4 1.1v-7.1H3v6Zm8.2 1.2L21 21.5v-8.6h-9.8v7.2Zm0-16.2v7.3H21V2.5l-9.8 1.4Z'
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.title}</title>
  <meta name="description" content={t.description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="DevForge" />
  <meta property="og:url" content={new URL(home, Astro.site).href} />
  <meta property="og:title" content={t.title} />
  <meta property="og:description" content={t.description} />
  <meta property="og:image" content={new URL(`${base}/og-${lang}.png`, Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL(`${base}/og-${lang}.png`, Astro.site).href} />
  <meta name="theme-color" content="#F6F4EF" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="alternate" hreflang={lang === 'en' ? 'fr' : 'en'} href={otherHome} />
</head>
<body>
  <a class="skip" href="#main">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>

  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href={home}>
        <span class="brand-mark"><svg width="18" height="18" viewBox="0 0 256 256" aria-hidden="true"><g fill="#f97316"><polygon points="40.96,87.04 199.68,87.04 199.68,117.76 76.8,117.76"></polygon><rect x="107.52" y="117.76" width="61.44" height="30.72"></rect><rect x="81.92" y="148.48" width="112.64" height="25.6"></rect></g></svg></span>
        DevForge
      </a>
      <nav class="links" aria-label="Menu">
        <a href="#features">{t.nav.features}</a>
        <a href="#servers">{t.nav.servers}</a>
        <a href="#forgy">{t.nav.forgy}</a>
        <a href={docs('getting-started/installation/')}>{t.nav.docs}</a>
        <a href="https://github.com/victhille/devforge/releases">{t.nav.releases}</a>
      </nav>
      <div class="top-end">
        <a class="lang" href={otherHome} hreflang={lang === 'en' ? 'fr' : 'en'} title={t.nav.other}>{t.nav.otherShort}</a>
        <a class="btn btn-dark btn-sm" href={docs('download/')}>{t.nav.download}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="wrap hero">
      <div class="hero-text">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title[0]}<span class="orange">{t.hero.title[1]}</span>{t.hero.title[2]}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions" data-download data-lang={lang}>
          <a class="btn btn-dark btn-lg" href={releases} data-link><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={winLogo}></path></svg>{t.hero.download}</a>
          <a class="btn btn-light btn-lg" href="#video"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>{t.hero.tour}</a>
          <p class="meta" data-meta></p>
        </div>
      </div>
      <div class="hero-art">
        <Image class="art-main" src={shot('home')} alt={t.hero.homeAlt} widths={[720, 1100]} sizes="(max-width: 1000px) 100vw, 640px" loading="eager" />
        <Image class="art-second" src={shot('project')} alt={t.hero.projectAlt} widths={[480, 720]} sizes="(max-width: 1000px) 60vw, 380px" loading="eager" />
        <div class="art-card" aria-hidden="true">
          <strong>{t.hero.card.title}</strong>
          <code>{t.hero.card.message}</code>
          <span class="card-buttons"><span class="ok">{t.hero.card.approve}</span><span>{t.hero.card.refuse}</span></span>
        </div>
      </div>
    </section>

    <!-- What it replaces -->
    <section class="wrap replaces">
      <p>
        <strong>{t.replaces.before}</strong>
        {t.replaces.items.map(i => <s>{i}</s>)}
        <strong>{t.replaces.after}</strong>
      </p>
    </section>

    <!-- The video: the built app with sample data, captions in the picture (the French one also has a voice-over) -->
    <section id="video" class="wrap video">
      <div class="video-text">
        <h2>{t.video.title}</h2>
        <p class="section-lead">{t.video.lead}</p>
      </div>
      <div class="video-frame">
        <video controls preload="none" playsinline width={videoSize.width} height={videoSize.height} poster={posterSrc} aria-label={t.video.label}>
          <source src={videoSrc} type="video/webm" />
        </video>
      </div>
    </section>

    <!-- A day -->
    <section id="day" class="band-white">
      <div class="wrap section">
        <h2>{t.day.title}</h2>
        <p class="section-lead">{t.day.lead}</p>
        <ol class="day">
          {t.day.steps.map(s => (
            <li>
              <span class="time">{s.time}</span>
              <Image class="day-shot" src={shot(s.shot)} alt={s.alt} widths={[400, 640]} sizes="(max-width: 900px) 100vw, 280px" loading="lazy" style={`object-position: ${s.pos}`} />
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
          <li>
            <span class="time">{t.day.deploy.time}</span>
            <div class="day-shot term" aria-hidden="true">
              <span class="dim">{t.day.deploy.path}</span>
              <span>$ git pull --ff-only</span>
              <span>$ npm ci &amp;&amp; npm run build</span>
              <span>$ pm2 restart boutique</span>
              <span class="green">{t.day.deploy.done}</span>
            </div>
            <h3>{t.day.deploy.title}</h3>
            <p>{t.day.deploy.text}</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- Projects tour -->
    <section id="features" class="wrap section projects" data-tour>
      <div class="projects-text">
        <h2>{t.projects.title}</h2>
        <p class="section-lead">{t.projects.lead}</p>
        <div class="tour-tabs" role="tablist" aria-label={t.projects.title}>
          {t.projects.tabs.map((tab, i) => (
            <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab>
              <span class="tab-title">{tab.title}</span>
              <span class="tab-text">{tab.text}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="projects-stage">
        {t.projects.tabs.map((tab, i) => (
          <div role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={i !== 0} data-panel>
            <Image src={shot(tab.id)} alt={tab.title} widths={[720, 1100]} sizes="(max-width: 1000px) 100vw, 760px" loading="lazy" />
          </div>
        ))}
      </div>
    </section>

    <!-- Servers -->
    <section id="servers" class="band-dark">
      <div class="wrap section servers">
        <div class="servers-text">
          <h2>{t.servers.title}</h2>
          <p class="section-lead">{t.servers.lead}</p>
          <dl class="specs">
            {t.servers.items.map(([title, text, link]) => (
              <div><dt><a href={docs(link)}>{title}</a></dt><dd>{text}</dd></div>
            ))}
          </dl>
        </div>
        <div class="health" aria-label={t.servers.health.note}>
          <div class="health-head"><span>{t.servers.health.title}</span><span class="badge">{t.servers.health.badge}</span></div>
          {t.servers.health.rows.map(([k, v]) => <div class="health-row"><span>{k}</span><span>{v}</span></div>)}
          <p class="health-note">{t.servers.health.note}</p>
        </div>
      </div>
    </section>

    <!-- Forgy -->
    <section id="forgy" class="wrap section forgy">
      <div class="forgy-text">
        <Forgy size={72} />
        <h2>{t.forgy.title}</h2>
        <p>{t.forgy.text}</p>
        <a class="more" href={docs('forgy/assistant/')}>{t.forgy.link} →</a>
      </div>
      <div class="panel" aria-hidden="true">
        <div class="panel-head"><strong>Forgy</strong> <span>· {t.forgy.mock.status}</span></div>
        <div class="panel-body">
          <p class="q">{t.forgy.mock.question}</p>
          <p>{t.forgy.mock.answer}</p>
          <div class="action">
            <strong>{t.forgy.mock.cardTitle}</strong>
            <code>{t.forgy.mock.cardCode}</code>
            <span class="card-buttons"><span class="ok">{t.forgy.mock.approve}</span><span>{t.forgy.mock.refuse}</span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ and download -->
    <section class="band-white">
      <div class="wrap section faq-get">
        <div class="faq">
          <h2>{t.faq.title}</h2>
          {t.faq.items.map(([q, a]) => (
            <details><summary>{q}</summary><p>{a}</p></details>
          ))}
        </div>
        <div class="get" data-download data-lang={lang} id="download">
          <h2>{t.get.title}</h2>
          <p>{t.get.text}</p>
          <a class="btn btn-dark btn-lg btn-block" href={releases} data-link><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={winLogo}></path></svg><span data-label>{t.get.button}</span></a>
          <p class="file" data-file>DevForge-Setup.exe</p>
          <a class="more center" href="https://github.com/victhille/devforge/releases" data-notes>{t.get.notes} →</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <span>{t.footer.made}</span>
      <a href={docs('getting-started/installation/')}>{t.footer.docs}</a>
      <a href={docs('developers/')}>{t.footer.developers}</a>
      <a href="https://github.com/victhille/devforge">GitHub</a>
      <a href="https://github.com/victhille/devforge/blob/main/LICENSE">{t.footer.license}</a>
      <a href={otherHome} hreflang={lang === 'en' ? 'fr' : 'en'}>{t.nav.other}</a>
      <p>{t.footer.privacy}</p>
    </div>
  </footer>

  <script>
    // The latest release fills the download buttons: no version is written in the page
    const API = 'https://api.github.com/repos/victhille/devforge/releases/latest'
    const INSTALLER = /^DevForge-Setup-v.+\.exe$/
    interface Release { tag_name: string; html_url: string; published_at: string; assets: { name: string; size: number; browser_download_url: string }[] }
    fetch(API, { headers: { Accept: 'application/vnd.github+json' } })
      .then(r => (r.ok ? (r.json() as Promise<Release>) : null))
      .catch(() => null)
      .then(r => {
        const exe = r?.assets.find(a => INSTALLER.test(a.name))
        if (!r || !exe) return
        const size = (fr: boolean) => `${Math.round(exe.size / 1048576)} ${fr ? 'Mo' : 'MB'}`
        for (const box of document.querySelectorAll<HTMLElement>('[data-download]')) {
          const fr = box.dataset.lang !== 'en'
          box.querySelector<HTMLAnchorElement>('[data-link]')!.href = exe.browser_download_url
          const date = new Date(r.published_at).toLocaleDateString(fr ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
          const meta = box.querySelector('[data-meta]')
          if (meta) meta.textContent = `${r.tag_name} · ${size(fr)} · ${fr ? 'publiée le' : 'released'} ${date}`
          const label = box.querySelector('[data-label]')
          if (label) label.textContent = `${label.textContent} ${r.tag_name}`
          const file = box.querySelector('[data-file]')
          if (file) file.textContent = `${exe.name} · ${size(fr)}`
          const notes = box.querySelector<HTMLAnchorElement>('[data-notes]')
          if (notes) notes.href = r.html_url
        }
      })

    // Projects tour: click or arrow keys
    const tour = document.querySelector<HTMLElement>('[data-tour]')
    if (tour) {
      const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[data-tab]')]
      const panels = [...tour.querySelectorAll<HTMLElement>('[data-panel]')]
      const select = (i: number, focus = false) => {
        const k = (i + tabs.length) % tabs.length
        tabs.forEach((tab, j) => { tab.setAttribute('aria-selected', String(j === k)); tab.tabIndex = j === k ? 0 : -1 })
        panels.forEach((p, j) => { p.hidden = j !== k })
        if (focus) tabs[k].focus()
      }
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i))
        tab.addEventListener('keydown', e => {
          if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); select(i + 1, true) }
          if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); select(i - 1, true) }
        })
      })
    }
  </script>

  <style is:global>
    :root {
      --paper: #F6F4EF; --white: #FFFFFF; --ink: #17191E; --ink-2: #4A505C; --ink-3: #6E7480; --rule: #E2DED6; --rule-2: #D6D1C8;
      --link: #1D4ED8; --orange: #E8630A;
      --app: #0D0F13; --app-panel: #111419; --app-2: #161A21; --app-line: #262C36; --app-line-2: #1F242D; --app-fg: #E8ECF2; --app-fg-2: #9AA4B2; --app-fg-3: #8792A2;
      --forgy: #FF9A3C; --green: #3FCF8E;
      --font: 'Geist Variable', 'Segoe UI', system-ui, sans-serif; --mono: 'Geist Mono Variable', ui-monospace, monospace;
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 17px/1.6 var(--font); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    img { max-width: 100%; height: auto; display: block; }
    h1, h2, h3 { margin: 0; letter-spacing: -0.03em; line-height: 1.1; }
    p { margin: 0; }
    a { color: var(--link); }
    a:hover { color: #1E40AF; }
    .wrap { width: min(1200px, 100% - 48px); margin-inline: auto; }
    .skip { position: absolute; left: -9999px; }
    .skip:focus { left: 12px; top: 12px; z-index: 10; background: var(--ink); color: #fff; padding: 8px 12px; }
    :focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }

    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none; font-weight: 600; border-radius: 10px; border: 1px solid transparent; }
    .btn-sm { padding: 9px 16px; font-size: 15px; border-radius: 8px; }
    .btn-lg { padding: 13px 22px; min-height: 48px; font-size: 16px; }
    .btn-block { display: flex; width: 100%; margin-top: 24px; }
    .btn-dark { background: var(--ink); color: #fff; }
    .btn-dark:hover { background: #2B2F37; color: #fff; }
    .btn-light { background: var(--white); color: var(--ink); border-color: var(--rule-2); }
    .btn-light:hover { border-color: #BDB6AA; color: var(--ink); }
    .more { display: inline-block; font-weight: 600; text-decoration: none; margin-top: 20px; }
    .more.center { display: block; text-align: center; font-size: 14.5px; margin-top: 16px; }

    .top { border-bottom: 1px solid var(--rule); background: var(--paper); }
    .top-inner { display: flex; align-items: center; gap: 32px; height: 68px; }
    .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-weight: 700; font-size: 18px; }
    .brand:hover { color: var(--ink); }
    .brand-mark { width: 30px; height: 30px; border-radius: 8px; background: #0F1117; display: inline-flex; align-items: center; justify-content: center; }
    .links { display: flex; gap: 24px; font-size: 15px; }
    .links a { color: var(--ink-2); text-decoration: none; }
    .links a:hover { color: var(--ink); }
    .top-end { margin-left: auto; display: flex; align-items: center; gap: 16px; }
    .lang { color: var(--ink-3); text-decoration: none; font: 600 13px var(--mono); }

    .hero { display: flex; flex-wrap: wrap; gap: 56px; align-items: center; padding: 88px 0 40px; }
    .hero-text { flex: 1 1 420px; min-width: 0; }
    .eyebrow { font-size: 14px; color: var(--ink-3); margin-bottom: 20px; }
    .hero h1 { font-size: clamp(42px, 5.4vw, 64px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 750; }
    .orange { color: var(--orange); }
    .lead { margin-top: 24px; font-size: 19px; color: var(--ink-2); max-width: 34em; }
    .actions { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .meta { width: 100%; margin-top: 2px; font: 13.5px var(--mono); color: var(--ink-3); min-height: 1.5em; }
    .hero-art { flex: 1 1 560px; min-width: 0; position: relative; padding-bottom: 80px; }
    .art-main { width: 100%; border-radius: 12px; border: 1px solid var(--app-line-2); box-shadow: 0 30px 60px -24px rgba(23,25,30,.55); }
    .art-second { position: absolute; width: 58%; right: -28px; bottom: 0; border-radius: 10px; border: 1px solid var(--app-line-2); box-shadow: 0 24px 50px -18px rgba(23,25,30,.6); }
    .art-card { position: absolute; left: -24px; bottom: 28px; width: 260px; background: var(--app-panel); color: var(--app-fg); border: 1px solid rgba(255,154,60,.45); border-radius: 12px; padding: 14px; box-shadow: 0 20px 40px -16px rgba(23,25,30,.6); font-size: 13px; display: flex; flex-direction: column; gap: 8px; }
    .art-card strong, .action strong { color: var(--forgy); }
    .art-card code, .action code { font: 13px var(--mono); background: #0A0C10; border: 1px solid var(--app-line-2); border-radius: 6px; padding: 6px 8px; }
    .card-buttons { display: flex; gap: 6px; }
    .card-buttons span { border: 1px solid var(--app-line); padding: 4px 10px; border-radius: 6px; font-size: 13px; }
    .card-buttons .ok { background: var(--forgy); color: #1A0E04; font-weight: 600; border-color: var(--forgy); }

    .replaces { padding: 24px 0 80px; }
    .replaces p { border-top: 1px solid var(--rule); padding-top: 32px; display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; font-size: 15px; color: var(--ink-3); }
    .replaces strong { color: var(--ink); font-weight: 600; }
    .replaces s { text-decoration-color: var(--orange); }

    .video { padding: 0 0 96px; scroll-margin-top: 24px; }
    .video h2 { font-size: clamp(30px, 3.6vw, 40px); }
    .video-text { max-width: 44em; }
    .video-frame { margin-top: 32px; background: var(--app); border-radius: 18px; padding: clamp(10px, 2vw, 24px); box-shadow: 0 30px 60px -28px rgba(23,25,30,.55); }
    .video-frame video { display: block; width: 100%; height: auto; border-radius: 10px; background: #0A0C10; }
    .band-white { background: var(--white); border-block: 1px solid var(--rule); }
    .band-dark { background: var(--app); color: var(--app-fg); }
    .section { padding-block: 104px; }
    .section h2 { font-size: clamp(30px, 3.6vw, 40px); }
    .section-lead { margin-top: 14px; font-size: 18px; color: var(--ink-2); max-width: 40em; }
    .band-dark .section-lead { color: var(--app-fg-2); }

    .day { list-style: none; padding: 0; margin: 56px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
    .day li { display: flex; flex-direction: column; gap: 12px; }
    .time { font: 600 13px var(--mono); color: var(--orange); }
    .day-shot { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; border: 1px solid var(--rule-2); }
    .day h3 { font-size: 18px; letter-spacing: -0.01em; }
    .day p { font-size: 15px; color: var(--ink-2); }
    .term { background: #0A0C10; border-color: var(--app-line-2); color: var(--app-fg); font: 12.5px var(--mono); padding: 16px; display: flex; flex-direction: column; gap: 6px; }
    .term .dim { color: var(--app-fg-2); }
    .term .green { margin-top: auto; color: var(--green); }

    .projects { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
    .projects-text { flex: 1 1 300px; min-width: 0; }
    .tour-tabs { margin-top: 28px; display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
    .tour-tabs button { all: unset; cursor: pointer; padding: 16px 0; border-bottom: 1px solid var(--rule); display: flex; flex-direction: column; gap: 4px; }
    .tour-tabs button:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
    .tab-title { font-weight: 650; font-size: 17px; color: var(--ink-3); }
    .tab-text { display: none; font-size: 15px; color: var(--ink-2); }
    .tour-tabs button[aria-selected='true'] .tab-title { color: var(--ink); }
    .tour-tabs button[aria-selected='true'] .tab-text { display: block; }
    .tour-tabs button:hover .tab-title { color: var(--ink); }
    .projects-stage { flex: 2 1 620px; min-width: 0; background: var(--app); border-radius: 16px; padding: 28px; }
    .projects-stage img { border-radius: 8px; border: 1px solid var(--app-line); }

    .servers { display: flex; flex-wrap: wrap; gap: 56px; }
    .servers-text { flex: 1 1 460px; min-width: 0; }
    .specs { margin: 36px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
    .specs div { padding: 16px 0; border-top: 1px solid var(--app-line); }
    .specs dt a { color: var(--app-fg); font-weight: 600; text-decoration: none; }
    .specs dt a:hover { color: #7EB0FF; }
    .specs dd { margin: 4px 0 0; color: var(--app-fg-2); font-size: 15px; }
    .health { flex: 1 1 380px; min-width: 0; align-self: center; background: var(--app-2); border: 1px solid var(--app-line); border-radius: 14px; padding: 24px; font-size: 14.5px; }
    .health-head { display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: 16px; margin-bottom: 18px; }
    .badge { font-size: 13px; font-weight: 500; color: var(--green); background: rgba(63,207,142,.12); padding: 3px 10px; border-radius: 999px; }
    .health-row { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--app-line-2); }
    .health-row span:last-child { color: var(--app-fg-2); text-align: right; }
    .health-note { margin-top: 14px; font-size: 12px; color: var(--app-fg-3); }

    .forgy { display: flex; flex-wrap: wrap; gap: 56px; align-items: center; }
    .forgy-text { flex: 1 1 440px; min-width: 0; }
    .forgy-text h2 { margin-top: 16px; }
    .forgy-text p { margin-top: 16px; font-size: 17px; color: var(--ink-2); }
    .panel { flex: 1 1 440px; min-width: 0; background: var(--app-panel); color: var(--app-fg); border: 1px solid var(--app-line); border-radius: 14px; overflow: hidden; font-size: 14.5px; box-shadow: 0 24px 50px -24px rgba(23,25,30,.6); }
    .panel-head { padding: 14px 18px; border-bottom: 1px solid var(--app-line-2); }
    .panel-head span { color: var(--app-fg-2); font-size: 13px; }
    .panel-body { padding: 18px; display: flex; flex-direction: column; gap: 12px; }
    .q { align-self: flex-end; background: rgba(91,155,255,.13); padding: 8px 12px; border-radius: 10px; }
    .action { border: 1px solid rgba(255,154,60,.4); background: rgba(255,154,60,.08); border-radius: 10px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }

    .faq-get { display: flex; flex-wrap: wrap; gap: 56px; }
    .faq { flex: 2 1 520px; min-width: 0; }
    .faq h2 { font-size: 32px; margin-bottom: 24px; }
    details { border-top: 1px solid var(--rule); padding: 16px 0; }
    details:last-child { border-bottom: 1px solid var(--rule); }
    summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; color: var(--ink-3); font-weight: 400; }
    details[open] summary::after { content: '−'; }
    details p { margin-top: 8px; color: var(--ink-2); }
    .get { flex: 1 1 320px; min-width: 0; align-self: flex-start; background: var(--paper); border: 1px solid var(--rule); border-radius: 16px; padding: 32px; }
    .get h2 { font-size: 26px; }
    .get > p { margin-top: 10px; color: var(--ink-2); font-size: 15px; }
    .file { margin-top: 12px; text-align: center; font: 13px var(--mono); color: var(--ink-3); }

    .foot { border-top: 1px solid var(--rule); }
    .foot-inner { padding: 28px 0 40px; display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: 14px; color: var(--ink-2); }
    .foot-inner a { color: var(--ink-2); }
    .foot-inner p { width: 100%; color: var(--ink-3); font-size: 13px; }

    @media (max-width: 1000px) {
      .links { display: none; }
      .day { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .art-second { right: 0; }
      .art-card { left: 0; }
    }
    @media (max-width: 600px) {
      body { font-size: 16px; }
      .hero { padding-top: 48px; }
      .section { padding-block: 72px; }
      .day, .specs { grid-template-columns: 1fr; }
      .top-end .btn { display: none; }
      .art-card { width: 220px; bottom: 12px; }
      .projects-stage { padding: 14px; }
    }
  </style>
</body>
</html>
