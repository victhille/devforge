---
/** Starlight's footer, followed by the site's sections: on a phone the tabs scroll, these stay at hand */
import Default from '@astrojs/starlight/components/Footer.astro'
import { SECTIONS } from './sections'

const en = Astro.locals.starlightRoute.lang === 'en'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Default />
<nav class="df-foot" aria-label={en ? 'Site' : 'Site'}>
  {SECTIONS.filter(s => s.id !== 'docs' && s.id !== 'guides').map(s => (
    <a href={`${base}/${en ? 'en/' : ''}${s.path}`}>{en ? s.en : s.fr}</a>
  ))}
  <a href="https://github.com/victhille/devforge/blob/main/LICENSE">{en ? 'MIT licence' : 'Licence MIT'}</a>
  <span>{en ? 'No cookies, no audience measurement.' : "Ni cookie ni mesure d'audience."}</span>
</nav>
